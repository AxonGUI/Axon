{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs:vue dev",
      "type": "shell",
      "command": "npm run docs:dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vitepress",
          "endsPattern": "Local"
        }
      }
    }
  ]
}
