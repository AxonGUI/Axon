{
  "name": "axon-gui",
  "version": "1.4.2",
  "type": "module",
  "files": [
    "dist",
    "tests/types/tsconfig.json",
    "vite-plugin.d.ts",
    "vite-plugin.js"
  ],
  "main": "./dist/axon.umd.cjs",
  "module": "./dist/axon.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/axon.js",
      "require": "./dist/axon.umd.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./vite-plugin": {
      "types": "./vite-plugin.d.ts",
      "import": "./vite-plugin.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/fix-dts-ext.mjs && node scripts/stamp-dist.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json && tsc -p tests/types/tsconfig.node16.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/promise-retry": "^1.1.6",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "promise-retry": "^2.0.1",
    "pyright": "1.1.414",
    "qwebchannel": "^6.2.0",
    "typescript": "^7.0.2",
    "uuid": ">=14.0.3",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "promise-retry": "^2.0.1",
    "qwebchannel": "^6.2.0",
    "uuid": ">=14.0.0"
  },
  "description": "Axon frontend runtime — QWebChannel calls both ways, store, events / Axon 的前端运行时（QWebChannel 双向调用 / Store / 事件）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxonGUI/Axon.git",
    "directory": "core-js"
  },
  "homepage": "https://axongui.github.io/Axon/",
  "keywords": [
    "axon",
    "qwebchannel",
    "pyqt",
    "pyside6",
    "desktop",
    "web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild": true
  }
}
